# ============================================================================
# AI Voice Agent — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to source control.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
# Port for the FastAPI server (src/api/server.py)
PORT=8000

# ── Model / Inference ───────────────────────────────────────────────────────
# LLM Provider selection. Leave unset (commented out, as below) to
# auto-select the best available option from whichever API keys below are
# actually configured -- see docs/FREE_TIER_SETUP.md and
# _default_provider_mode(). With GEMINI_API_KEY + GROQ_API_KEY filled in
# below and no ANTHROPIC_API_KEY, this already resolves to "free_fallback"
# automatically -- no LLM spend. Only "fallback"/"claude" ever cost money,
# and only once you actually fill in ANTHROPIC_API_KEY.
#   "free_fallback" -> Gemini Primary, Groq Fallback (both free-tier)
#   "fallback"      -> Claude Primary, Gemini Fallback (PAID)
#   "claude"        -> Anthropic Claude only (PAID)
#   "gemini"        -> Google Gemini only (free-tier)
#   "groq"          -> Groq only (free-tier)
#   "local"         -> Local Qwen2.5 HuggingFace model (fully offline, zero cost)
# LLM_PROVIDER=free_fallback

# Anthropic Claude configuration (Primary provider in "fallback" mode).
# PAID -- costs money per request. Leave unset to avoid any Claude spend;
# the app then auto-selects a free provider instead (see above).
# Recommended: "claude-3-5-haiku-latest" (lowest latency for voice) or "claude-3-5-sonnet-latest"
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini configuration (free-tier). Primary in "free_fallback"/"gemini"
# modes, automatic fallback in "fallback" mode. Get a key at
# https://aistudio.google.com/apikey -- Recommended: "gemini-2.5-flash" or "gemini-2.0-flash"
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq configuration (free-tier). Fallback in "free_fallback" mode, or
# standalone in "groq" mode. Get a key at https://console.groq.com/keys --
# default model deliberately avoids Groq's reasoning models (e.g.
# openai/gpt-oss-*), which can silently return empty text within a modest
# token budget -- see docs/FREE_TIER_SETUP.md.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# HuggingFace model identifier or local path to a merged model directory (for local mode).
# Default: "Qwen/Qwen2.5-0.5B-Instruct" (base model)
BASE_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Path to a pre-merged model directory (produced by src/export/merge_and_convert.py).
# If this directory exists, the merged model is loaded directly (no adapter attach).
# Default: "outputs/merged_model"
MERGED_MODEL_DIR=outputs/merged_model

# HuggingFace Hub token — required for gated models or private repos.
# Used by Docker containers (docker/docker-compose.yml).
# HF_TOKEN=

# ── Environment / security posture (src/agent/runtime_env.py) ─────────────
# Decides whether development conveniences are available. UNSET MEANS
# PRODUCTION (closed by default).
#   "dev"                    → local development / tests: anonymous text API,
#                              AUTH_MODE=dev tokens, VOICE_MOCK_SERVICES,
#                              TELEPHONY_MOCK_PIN and unsigned Twilio endpoints
#                              are allowed.
#   "staging" / "production" → all of the above are refused; the server will
#                              not start with AUTH_MODE=dev, mock voice, or a
#                              mock PIN, and every text-API call must
#                              authenticate.
APP_ENV=dev

# Text-API rate limit per authenticated identity (token bucket).
# Default: 60/min (burst 10) outside dev; 0 = disabled (the dev default).
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_BURST=10

# Voice call admission (per process) and maximum call length.
# MAX_CONCURRENT_CALLS=10
# MAX_CALL_DURATION_SECONDS=1800

# Spoken by Twilio itself (TwiML <Say> after <Connect>) whenever the service
# ends a call's media stream: provider unavailable, repeated turn failures,
# maximum call length, dead stream. Works even when TTS is the failed part.
# Per-stage voice deadlines live in configs/reliability.yaml (`voice:`).
# VOICE_FALLBACK_MESSAGE=We're sorry, we can't continue this call right now. Please call back later. Goodbye.
#
# Clinical safety (docs/CLINICAL_SAFETY.md, "Voice: when TTS fails"): a call
# that produced an URGENT-risk answer never ends on the message above. Before
# closing its stream the server asks Twilio (call-update request, using
# TWILIO_AUTH_TOKEN and the call's own SIDs) to speak this instead, then hang
# up. Empty or unset -> the built-in default below. Name a phone number here
# ONLY if it is verified for the deployment's location.
# VOICE_URGENT_FALLBACK_MESSAGE=This may need urgent medical help. Please hang up and call your local emergency number right now, or poison control if it's a possible overdose. We can't continue this call, and we can't call anyone for you from this line. Goodbye.

# ── Authentication (src/agent/identity.py, src/agent/oidc_provider.py) ─────
# Which authentication provider to use.
#   "dev" (default)  → DevelopmentAuthenticationProvider (test-only,
#                      deterministic; only permitted with APP_ENV=dev)
#   "production"     → OIDCAuthenticationProvider (real JWT/OIDC validation)
#   "oidc"           → same as "production"
AUTH_MODE=dev

# Set to "false" to disable the development auth provider entirely.
# Use this in production to ensure dev auth can never be an accidental fallback.
DEV_AUTH_ENABLED=true

# OIDC configuration — required when AUTH_MODE=production or AUTH_MODE=oidc.
# These override values from configs/auth.yaml if both are set.
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_AUDIENCE=your-client-id
# OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ── Persistence (src/agent/db.py) ──────────────────────────────────────────
# Which persistence mode to use.
#   unset / "dev"    → in-memory repositories (no database required)
#   "production"     → PostgreSQL via DATABASE_URL (fails closed if unavailable)
#   "postgres"       → same as "production"
#   "postgresql"     → same as "production"
PERSISTENCE_MODE=dev

# PostgreSQL connection URL — required when PERSISTENCE_MODE=production.
# The password in this URL is NEVER logged (see db.py's _mask_url).
# DATABASE_URL=postgresql://voice_app:voice_secret@localhost:5432/ai_voice_agent

# ── Voice / Telephony (Twilio, Deepgram STT, ElevenLabs TTS) ───────────────
# Deepgram API key — required for streaming real-time STT (src/voice/stt_service.py).
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ElevenLabs API key — required for streaming real-time TTS (src/voice/tts_service.py).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Set to "true" to use deterministic mock STT/TTS services during offline testing / dev
# (only permitted with APP_ENV=dev). Outside dev, TWILIO_AUTH_TOKEN must be set or
# /twiml/inbound-call and /ws/call reject every request.
VOICE_MOCK_SERVICES=false

# URL of the inference API's /generate endpoint (for legacy client_tts.py).
# Default: "http://localhost:8000/generate"
# VOICE_API_URL=http://localhost:8000/generate

# Phase 18 security fix: a shared 4-digit PIN an unauthenticated telephony
# caller must speak to proceed past a permission-gated tool action (e.g.
# ORDER_LOOKUP) -- see ConversationManager's "caller_pin" docstring. This
# is NOT real per-caller identity verification (there is no per-patient
# PIN store); it is a single shared secret suitable ONLY for a controlled
# canary/demo where every caller is known out of band. Leave unset (the
# default, and the only safe value for any real/public deployment) to
# fail closed: every such attempt is handed off to a human instead of
# silently trusting a guessable value. Only permitted with APP_ENV=dev.
# TELEPHONY_MOCK_PIN=

# ── Export / GGUF (src/export/merge_and_convert.py) ────────────────────────
# Path to a local llama.cpp checkout (for GGUF conversion only).
# LLAMA_CPP_DIR=

# ── Logging ────────────────────────────────────────────────────────────────
# Python logging level. Default: WARNING
# LOG_LEVEL=INFO

# ── Distributed Tracing (Phase 14: OpenTelemetry) ──────────────────────────
# Set to "true" to enable OpenTelemetry distributed tracing across turn orchestration.
# When false (default), tracing is completely disabled with zero runtime overhead.
# TRACING_ENABLED=false
# OTEL_SERVICE_NAME=ai-voice-agent
# OTEL_EXPORTER_TYPE=console       # "console" | "otlp" | "memory"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # Jaeger/Tempo/Cloud Trace endpoint
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=

