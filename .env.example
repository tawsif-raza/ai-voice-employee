# ============================================================================
# AI Voice Agent — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to source control.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
# Port for the FastAPI server (src/api/server.py)
PORT=8000

# ── Model / Inference ───────────────────────────────────────────────────────
# LLM Provider selection:
#   "fallback" (default when keys set) -> Claude Primary, Gemini Fallback
#   "claude"                           -> Anthropic Claude only
#   "gemini"                           -> Google Gemini only
#   "local"                            -> Local Qwen2.5 HuggingFace model
LLM_PROVIDER=fallback

# Anthropic Claude configuration (Primary provider)
# Recommended: "claude-3-5-haiku-latest" (lowest latency for voice) or "claude-3-5-sonnet-latest"
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini configuration (Automatic Fallback provider)
# Recommended: "gemini-2.5-flash" or "gemini-2.0-flash"
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# HuggingFace model identifier or local path to a merged model directory (for local mode).
# Default: "Qwen/Qwen2.5-0.5B-Instruct" (base model)
BASE_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Path to a pre-merged model directory (produced by src/export/merge_and_convert.py).
# If this directory exists, the merged model is loaded directly (no adapter attach).
# Default: "outputs/merged_model"
MERGED_MODEL_DIR=outputs/merged_model

# HuggingFace Hub token — required for gated models or private repos.
# Used by Docker containers (docker/docker-compose.yml).
# HF_TOKEN=

# ── Authentication (src/agent/identity.py, src/agent/oidc_provider.py) ─────
# Which authentication provider to use.
#   "dev" (default)  → DevelopmentAuthenticationProvider (test-only, deterministic)
#   "production"     → OIDCAuthenticationProvider (real JWT/OIDC validation)
#   "oidc"           → same as "production"
AUTH_MODE=dev

# Set to "false" to disable the development auth provider entirely.
# Use this in production to ensure dev auth can never be an accidental fallback.
DEV_AUTH_ENABLED=true

# OIDC configuration — required when AUTH_MODE=production or AUTH_MODE=oidc.
# These override values from configs/auth.yaml if both are set.
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_AUDIENCE=your-client-id
# OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ── Persistence (src/agent/db.py) ──────────────────────────────────────────
# Which persistence mode to use.
#   unset / "dev"    → in-memory repositories (no database required)
#   "production"     → PostgreSQL via DATABASE_URL (fails closed if unavailable)
#   "postgres"       → same as "production"
#   "postgresql"     → same as "production"
PERSISTENCE_MODE=dev

# PostgreSQL connection URL — required when PERSISTENCE_MODE=production.
# The password in this URL is NEVER logged (see db.py's _mask_url).
# DATABASE_URL=postgresql://voice_app:voice_secret@localhost:5432/ai_voice_agent

# ── Voice / Telephony (Twilio, Deepgram STT, ElevenLabs TTS) ───────────────
# Deepgram API key — required for streaming real-time STT (src/voice/stt_service.py).
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ElevenLabs API key — required for streaming real-time TTS (src/voice/tts_service.py).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Set to "true" to use deterministic mock STT/TTS services during offline testing / dev
VOICE_MOCK_SERVICES=false

# URL of the inference API's /generate endpoint (for legacy client_tts.py).
# Default: "http://localhost:8000/generate"
# VOICE_API_URL=http://localhost:8000/generate

# ── Export / GGUF (src/export/merge_and_convert.py) ────────────────────────
# Path to a local llama.cpp checkout (for GGUF conversion only).
# LLAMA_CPP_DIR=

# ── Logging ────────────────────────────────────────────────────────────────
# Python logging level. Default: WARNING
# LOG_LEVEL=INFO

# ── Distributed Tracing (Phase 14: OpenTelemetry) ──────────────────────────
# Set to "true" to enable OpenTelemetry distributed tracing across turn orchestration.
# When false (default), tracing is completely disabled with zero runtime overhead.
# TRACING_ENABLED=false
# OTEL_SERVICE_NAME=ai-voice-agent
# OTEL_EXPORTER_TYPE=console       # "console" | "otlp" | "memory"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # Jaeger/Tempo/Cloud Trace endpoint
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=

