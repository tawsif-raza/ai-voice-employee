.env
# Every local env file holds real credentials (e.g. the documented
# `docker compose ... --env-file .env.canary`); only the placeholder
# templates are tracked.
.env.*
!.env.example
!.env.canary.example
__pycache__/
*.pyc
data/raw/
*.pt
*.bin
*.safetensors
models/
.venv/
data/cleaned/
data/processed/
data/custom/

# Local/scratch SQLite databases (dev PERSISTENCE_MODE, ad hoc Alembic
# verification) -- never a real PostgreSQL deployment artifact.
*.db

# Training/eval run artifacts (checkpoints, logs, eval reports, RAG index) --
# regenerated locally, not deployment or source artifacts.
outputs/

# Phase 1.4 live external-integration harness output -- regenerated by
# whoever actually runs scripts/live_provider_verification.py /
# scripts/live_twilio_readiness_check.py against real credentials; never a
# checked-in fixture, and its content is only meaningful for the
# environment/credentials that produced it.
docs/phase1.4-live-provider-results.json
docs/phase1.4-live-twilio-results.json
