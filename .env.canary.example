# ============================================================================
# AI Voice Agent — Canary / Production Environment Variables Template
# ============================================================================
# Copy this file to .env.canary and populate values for the canary environment:
#   cp .env.canary.example .env.canary
#
# DO NOT hardcode or commit secrets (.env.canary is gitignored).
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Model / Provider Configuration ──────────────────────────────────────────
# Provider routing: "fallback" (Claude primary, Gemini fallback), "claude", "gemini", "local"
LLM_PROVIDER=fallback

# Anthropic Claude (Primary Voice Model)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (Automatic Fallback Voice Model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Base model fallback
BASE_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MERGED_MODEL_DIR=/app/outputs/merged_model
HF_TOKEN=

# ── Environment / security posture (src/agent/runtime_env.py) ─────────────
# A canary is a real deployment: staging posture (same strictness as
# production). Requires AUTH_MODE=production and TWILIO_AUTH_TOKEN.
APP_ENV=staging

# ── Production Authentication (OIDC / JWT) ──────────────────────────────────
# In production canary, AUTH_MODE must be "production" or "oidc"
AUTH_MODE=production
DEV_AUTH_ENABLED=false
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_AUDIENCE=your-canary-audience
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ── Database & Persistence ──────────────────────────────────────────────────
# In production canary, PERSISTENCE_MODE must be "production"
PERSISTENCE_MODE=production
DATABASE_URL=postgresql://voice_app:voice_secret@postgres:5432/ai_voice_agent
POSTGRES_DB=ai_voice_agent
POSTGRES_USER=voice_app
POSTGRES_PASSWORD=voice_secret

# ── Voice / Telephony Transport ─────────────────────────────────────────────
# Real provider API keys for controlled canary environment
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Twilio Telephony Webhook & Stream
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MEDIA_STREAM_URL=wss://canary-voice.example.com/ws/call
VOICE_PUBLIC_URL=https://canary-voice.example.com

# Mock service flag: set to "false" for live canary, "true" for automated tests
VOICE_MOCK_SERVICES=false

# ── Observability & Telemetry ───────────────────────────────────────────────
OTEL_SERVICE_NAME=ai-voice-agent-canary
CANARY_DEPLOYMENT_ID=canary-20260909-01